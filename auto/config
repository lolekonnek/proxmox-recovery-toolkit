#!/bin/sh
set -e

if ! lb config --help 2>&1 | grep -q -- '--bootloaders'; then
    printf '%s\n' \
        "Zainstalowany live-build nie obsługuje opcji --bootloaders." \
        "Wymagany jest nowszy live-build z obsługą BIOS i UEFI." \
        "Zbuduj obraz w Debianie Bookworm; nie usuwaj tej opcji, bo jest potrzebna do konfiguracji rozruchu." >&2
    exit 1
fi

lb config noauto \
    --mode debian \
    --distribution bookworm \
    --architectures amd64 \
    --binary-images iso-hybrid \
    --bootloaders "syslinux grub-efi" \
    --archive-areas "main contrib non-free-firmware" \
    --debian-installer none \
    --iso-application "Proxmox Recovery Toolkit" \
    --iso-publisher "Proxmox Recovery Toolkit" \
    --iso-volume "PROXMOX_RECOVERY"
